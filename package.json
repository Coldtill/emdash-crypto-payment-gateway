{
	"name": "@coldtill/emdash",
	"version": "1.0.0",
	"private": true,
	"description": "Coldtill crypto payments for EmDash: sell products from your content with a self-hosted, self-custody gateway.",
	"license": "MIT",
	"author": "Coldtill (https://coldtill.com)",
	"homepage": "https://coldtill.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Coldtill/emdash-crypto-payment-gateway.git"
	},
	"keywords": ["emdash", "emdash-plugin", "crypto", "payments", "coldtill"],
	"type": "module",
	"packageManager": "pnpm@10.4.1",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./storefront": {
			"types": "./dist/storefront/index.d.ts",
			"import": "./dist/storefront/index.js"
		}
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build && pnpm run build:storefront",
		"build:storefront": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --declaration --lib ES2022,DOM,DOM.Iterable --rootDir src/storefront --outDir dist/storefront src/storefront/index.ts",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.3.1",
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "0.2.10",
		"emdash": "1.3.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
